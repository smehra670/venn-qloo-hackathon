{
  "name": "venn",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Venn is an AI agent that uses taste data to find the businesses whose audiences overlap with yours, shows them on a graph, and writes the collab pitch.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"vite\" \"tsx watch --tsconfig tsconfig.server.json server/index.ts\"",
    "build": "rimraf dist && cross-env NODE_ENV=production vite build && tsup",
    "start": "cross-env NODE_ENV=production node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "smoke:remote": "node scripts/smoke.mjs",
    "e2e:swipe": "node scripts/e2e-swipe.mjs",
    "qloo:probe": "node scripts/qloo-probe-v2.mjs",
    "snapshot": "tsx --tsconfig tsconfig.server.json scripts/snapshot.ts",
    "cards:seed": "tsx --tsconfig tsconfig.server.json scripts/cards-seed.ts",
    "og": "node scripts/make-og.mjs",
    "shots": "node scripts/capture-shots.mjs",
    "shots:research": "node scripts/capture-research.mjs",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smehra670/venn-inhouse.git"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-toggle-group": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.3.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-zoom": "^3.0.0",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.5",
    "framer-motion": "^14.1.0",
    "fuse.js": "^7.5.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "maplibre-gl": "^6.14.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-zoom": "^3.0.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
