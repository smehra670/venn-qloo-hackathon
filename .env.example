PORT=8787
HOST=0.0.0.0
NODE_ENV=development
TASTE_PROVIDER=mock        # mock | qloo | snapshot
MOCK_LATENCY=normal        # normal | fast | off
TRUST_PROXY=false
RATE_LIMIT_MAX=120
RATE_LIMIT_RUNS_PER_MIN=8
DATA_DIR=./data
RUN_TTL_HOURS=24
RUN_TTL_DAYS=              # optional; overrides RUN_TTL_HOURS as days*24 when set
SHARE_TTL_HOURS=168
SHARE_TTL_DAYS=            # optional; overrides SHARE_TTL_HOURS as days*24 when set
MAX_CONCURRENT_RUNS=2
QUEUE_MAX=20
DAILY_RUN_CAP_PER_IP=40
SNAPSHOT_DIR=./snapshots
APP_SALT=                  # optional; salts the per-IP hash used for the daily run cap
# Required when TASTE_PROVIDER=qloo. Hackathon keys only work on this base URL.
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_API_KEY=
QLOO_CIRCUIT_FAILURES=5
QLOO_CIRCUIT_COOLDOWN_MS=30000
# Client-side pacing against the hackathon key's monthly quota.
QLOO_MAX_RPS=4
QLOO_MAX_IN_FLIGHT=3
QLOO_MONTHLY_FLOOR=500     # live runs are refused with 429 quota_low below this many calls remaining
# Forward-looking soft caps (not yet enforced; Proof/Compare reuse a run's existing signals).
PROOF_MAX_CALLS=24
COMPARE_MAX_CALLS_PER_RUN=10
# snapshot | live — snapshot (default) replays example searches from disk even when
# TASTE_PROVIDER is mock/qloo, so judging doesn't burn quota on the built-in examples.
EXAMPLES_MODE=snapshot
# Optional link surfaced on GET /api/meta (e.g. for an "About"/source link in the UI).
PUBLIC_REPO_URL=
# LLM — OpenAI or Anthropic for AI briefs (optional). Never commit real keys.
# LLM_PROVIDER=openai requires OPENAI_API_KEY (or LLM_API_KEY); LLM_PROVIDER=anthropic requires
# ANTHROPIC_API_KEY (or LLM_API_KEY). The app refuses to boot without the matching key — no
# silent fallback between providers — except under NODE_ENV=test.
LLM_PROVIDER=              # openai | anthropic | none | fake
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_API_KEY=               # legacy alias; prefer OPENAI_API_KEY / ANTHROPIC_API_KEY
LLM_MODEL=gpt-4.1-mini
LLM_MODEL_FAST=gpt-4.1-mini
LLM_BRIEF_BUDGET_PER_RUN=6
